<?xml version="1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="arm_length" value="0.15"/>
  <xacro:property name="body_mass" value="0.9"/>
  <xacro:property name="rotor_mass" value="0.02"/>
  <xacro:property name="rotor_radius" value="0.09"/>

  <!-- ============ BASE LINK ============ -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.25 0.25 0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.25 0.25 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0067" ixy="0" ixz="0" iyy="0.0067" iyz="0" izz="0.0123"/>
    </inertial>
  </link>

  <!-- Placa de control (tu PCB exportada) atornillada al chasis -->
  <xacro:include filename="$(find drone_description)/urdf/pcb_link.xacro"/>
  <joint name="pcb_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pcb_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ============ IMU ============ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ============ MACRO: ROTOR ============ -->
  <xacro:macro name="rotor" params="suffix motor_number xyz turning_direction">
    <link name="rotor_${suffix}">
      <visual>
        <geometry>
          <cylinder radius="${rotor_radius}" length="0.01"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${rotor_radius}" length="0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${rotor_mass}"/>
        <inertia ixx="9.75e-6" ixy="0" ixz="0" iyy="1.66e-4" iyz="0" izz="1.66e-4"/>
      </inertial>
    </link>

    <joint name="rotor_${suffix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rotor_${suffix}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.005"/>
    </joint>

    <!-- Plugin de motor por rotor (gz-sim). Publica/suscribe velocidad de motor -->
    <gazebo>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>drone</robotNamespace>
        <jointName>rotor_${suffix}_joint</jointName>
        <linkName>rotor_${suffix}</linkName>
        <turningDirection>${turning_direction}</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1500</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.06</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>${motor_number}</motorNumber>
        <rotorDragCoefficient>8.06428e-04</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- 4 rotores en cruz: cw / ccw alternados -->
  <xacro:rotor suffix="fl" motor_number="0" xyz=" ${arm_length}  ${arm_length} 0.03" turning_direction="ccw"/>
  <xacro:rotor suffix="fr" motor_number="1" xyz=" ${arm_length} -${arm_length} 0.03" turning_direction="cw"/>
  <xacro:rotor suffix="bl" motor_number="2" xyz="-${arm_length}  ${arm_length} 0.03" turning_direction="cw"/>
  <xacro:rotor suffix="br" motor_number="3" xyz="-${arm_length} -${arm_length} 0.03" turning_direction="ccw"/>

  <!-- Plugins base del modelo -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>30</static_update_frequency>
    </plugin>
  </gazebo>

</robot>
